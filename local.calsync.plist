<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.calsync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/USERNAME/bin/calsync</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Logs/calsync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Logs/calsync.log</string>
</dict>
</plist>
